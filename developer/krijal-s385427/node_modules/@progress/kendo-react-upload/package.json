{
  "name": "@progress/kendo-react-upload",
  "version": "16.1.0",
  "description": "React Upload component helps users transfer files from their file systems to dedicated server handlers. KendoReact Upload package",
  "author": "Progress",
  "license": "SEE LICENSE IN LICENSE.md",
  "homepage": "https://www.telerik.com/kendo-react-ui",
  "main": "./index.js",
  "module": "./index.mjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./index.d.mts",
        "default": "./index.mjs"
      },
      "require": {
        "types": "./index.d.ts",
        "default": "./index.js"
      }
    },
    "./package.json": {
      "default": "./package.json"
    }
  },
  "sideEffects": false,
  "peerDependencies": {
    "@progress/kendo-licensing": "^1.7.2",
    "@progress/kendo-react-buttons": "16.1.0",
    "@progress/kendo-react-common": "16.1.0",
    "@progress/kendo-react-intl": "16.1.0",
    "@progress/kendo-react-progressbars": "16.1.0",
    "@progress/kendo-svg-icons": "^4.9.0 || ^5.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "prop-types": "^15.6.0"
  },
  "keywords": [
    "Kendo UI",
    "React",
    "Progress",
    "Upload",
    "KendoReact",
    "reactjs",
    "UI",
    "components",
    "React component",
    "Telerik"
  ],
  "@progress": {
    "friendlyName": "Upload",
    "framework": "KendoReact",
    "migrations": {
      "options": {
        "parser": "tsx",
        "pattern": "*.{js,jsx,ts,tsx}"
      },
      "codemods": {
        "16": [
          {
            "description": "Migrate UploadClassComponent and Upload ref/type usages to the new UploadHandle type.",
            "file": "codemods/v16/upload-handle",
            "prompt": true
          }
        ]
      }
    },
    "package": {
      "productName": "KendoReact",
      "productCode": "KENDOUIREACT",
      "publishDate": 1788866059,
      "licensingDocsUrl": "https://www.telerik.com/kendo-react-ui/components/my-license/"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/telerik/kendo-react.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependenciesMeta": {
    "@progress/kendo-svg-icons": {
      "optional": true
    }
  }
}