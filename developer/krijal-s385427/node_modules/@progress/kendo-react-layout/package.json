{
  "name": "@progress/kendo-react-layout",
  "version": "16.1.0",
  "description": "React Layout components enable you to create a perceptive and intuitive layout of web projects. KendoReact Layout package",
  "author": "Progress",
  "license": "SEE LICENSE IN LICENSE.md",
  "homepage": "https://www.telerik.com/kendo-react-ui",
  "main": "./index.js",
  "module": "./index.mjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./index.d.mts",
        "default": "./index.mjs"
      },
      "require": {
        "types": "./index.d.ts",
        "default": "./index.js"
      }
    },
    "./package.json": {
      "default": "./package.json"
    }
  },
  "sideEffects": false,
  "peerDependencies": {
    "@progress/kendo-licensing": "^1.7.2",
    "@progress/kendo-react-animation": "16.1.0",
    "@progress/kendo-react-buttons": "16.1.0",
    "@progress/kendo-react-common": "16.1.0",
    "@progress/kendo-react-intl": "16.1.0",
    "@progress/kendo-react-popup": "16.1.0",
    "@progress/kendo-react-progressbars": "16.1.0",
    "@progress/kendo-svg-icons": "^4.9.0 || ^5.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "prop-types": "^15.6.0"
  },
  "keywords": [
    "Kendo UI",
    "React",
    "Progress",
    "TabStrip",
    "PanelBar",
    "Splitter",
    "Menu",
    "Drawer",
    "KendoReact",
    "KendoReact Free",
    "reactjs",
    "UI",
    "components",
    "React component",
    "free React component",
    "layout",
    "action sheet",
    "app bar",
    "bottom navigation",
    "breadcrumb",
    "card",
    "context menu",
    "expansion panel",
    "grid layout",
    "stack layout",
    "stepper",
    "tile layout",
    "timeline",
    "Telerik"
  ],
  "@progress": {
    "friendlyName": "Layout",
    "framework": "KendoReact",
    "migrations": {
      "options": {
        "parser": "tsx",
        "pattern": "*.{js,jsx,ts,tsx}"
      },
      "codemods": {
        "15": [
          {
            "description": "Remove deprecated themeColor values from AppBar. Valid values: 'base' | 'primary' | 'secondary' | 'tertiary' | 'inverse'.",
            "file": "codemods/v15/appbar-theme-color",
            "prompt": true
          },
          {
            "description": "Remove deprecated themeColor values from Avatar. Valid values: 'base' | 'primary' | 'secondary' | 'tertiary'.",
            "file": "codemods/v15/avatar-theme-color",
            "prompt": true
          },
          {
            "description": "Remove deprecated themeColor values from BottomNavigation. Valid values: 'base' | 'primary' | 'secondary' | 'tertiary' | 'inverse'.",
            "file": "codemods/v15/bottomnav-theme-color",
            "prompt": true
          }
        ],
        "16": [
          {
            "description": "Flags files that reference Menu submenu CSS classes affected by the v16 rendering change (k-menu-group-md removed, k-group and k-reset removed from submenu list).",
            "file": "codemods/v16/menu-rendering-changes",
            "prompt": false
          }
        ]
      }
    },
    "package": {
      "productName": "KendoReact",
      "productCode": "KENDOUIREACT",
      "publishDate": 1788866006,
      "licensingDocsUrl": "https://www.telerik.com/kendo-react-ui/components/my-license/"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/telerik/kendo-react.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependenciesMeta": {
    "@progress/kendo-svg-icons": {
      "optional": true
    }
  }
}