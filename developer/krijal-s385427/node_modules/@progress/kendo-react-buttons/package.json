{
  "name": "@progress/kendo-react-buttons",
  "version": "16.1.0",
  "description": "All you need in React Button in one package: disabled/enabled states, built-in styles and more. KendoReact Buttons package",
  "author": "Progress",
  "license": "SEE LICENSE IN LICENSE.md",
  "homepage": "https://www.telerik.com/kendo-react-ui",
  "main": "./index.js",
  "module": "./index.mjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./index.d.mts",
        "default": "./index.mjs"
      },
      "require": {
        "types": "./index.d.ts",
        "default": "./index.js"
      }
    },
    "./package.json": {
      "default": "./package.json"
    }
  },
  "sideEffects": false,
  "peerDependencies": {
    "@progress/kendo-smartpaste-common": "1.0.0",
    "@progress/kendo-licensing": "^1.7.2",
    "@progress/kendo-webspeech-common": "^1.0.1",
    "@progress/kendo-react-common": "16.1.0",
    "@progress/kendo-react-intl": "16.1.0",
    "@progress/kendo-react-popup": "16.1.0",
    "@progress/kendo-svg-icons": "^4.9.0 || ^5.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "prop-types": "^15.6.0"
  },
  "keywords": [
    "Kendo UI",
    "React",
    "Progress",
    "Buttons",
    "KendoReact",
    "KendoReact Free",
    "reactjs",
    "UI",
    "components",
    "React component",
    "free React component",
    "button group",
    "chip",
    "chip list",
    "dropdown button",
    "floating action button",
    "split button",
    "toolbar",
    "Telerik"
  ],
  "@progress": {
    "friendlyName": "Buttons",
    "framework": "KendoReact",
    "migrations": {
      "options": {
        "parser": "tsx",
        "pattern": "*.{js,jsx,ts,tsx}"
      },
      "codemods": {
        "15": [
          {
            "description": "Remove deprecated themeColor values ('dark', 'light') from Button, DropDownButton, and SplitButton. Valid values: 'base' | 'primary' | 'secondary' | 'tertiary' | 'info' | 'success' | 'warning' | 'error' | 'inverse'.",
            "file": "codemods/v15/theme-color",
            "prompt": true
          },
          {
            "description": "Remove deprecated themeColor values from FloatingActionButton. Valid values: 'base' | 'primary' | 'secondary' | 'tertiary'.",
            "file": "codemods/v15/fab-theme-color",
            "prompt": true
          }
        ],
        "16": [
          {
            "description": "Flags files that reference the DropDownButton and SplitButton ARIA role attributes that changed from menu/menuitem to list/listitem.",
            "file": "codemods/v16/buttons-rendering-changes",
            "prompt": false
          }
        ]
      }
    },
    "package": {
      "productName": "KendoReact",
      "productCode": "KENDOUIREACT",
      "publishDate": 1788865991,
      "licensingDocsUrl": "https://www.telerik.com/kendo-react-ui/components/my-license/"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/telerik/kendo-react.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependenciesMeta": {
    "@progress/kendo-svg-icons": {
      "optional": true
    }
  }
}